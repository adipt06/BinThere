# Supply a token with Directions and Search Box access; do not commit real tokens.
MAPBOX_TOKEN=your_mapbox_token_here
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
OVERPASS_API_URL=https://overpass.private.coffee/api/interpreter
# Optional fallback instance that supports Overpass QL linestring around queries.
OVERPASS_ALT_URL=https://overpass-api.de/api/interpreter
# Optional ordered list replaces the two URLs above; at most three unique endpoints are used.
# OVERPASS_ENDPOINTS=https://overpass.private.coffee/api/interpreter,https://overpass-api.de/api/interpreter
# Set a descriptive identifier; add a real contact URL/email if you deploy publicly.
OVERPASS_USER_AGENT=BinThere-HackRU/1.0 (environmental walking navigation)
OVERPASS_CACHE_SECONDS=90
# Combined queries are attempted only within this radius; fallback coverage is disclosed.
OVERPASS_COMBINED_MAX_RADIUS=1000
OVERPASS_CATEGORY_MAX_RADIUS=200
MAX_SNAP_METERS=50
OPTIMIZER_MAX_CANDIDATES=8
OPTIMIZER_TIMEOUT_SECONDS=45
OPTIMIZER_MAX_CORRIDOR_METERS=2000
NEAREST_MAX_CANDIDATES=6
# Category-specific nearby searches avoid expensive combined queries by default.
OVERPASS_COMBINED_ENABLED=false
# Genuine OSM snapshots; partial geographic coverage is disclosed in metadata mode.
FACILITY_DATA_MODE=local_first
LOCAL_FACILITIES_ENABLED=true
LOCAL_FACILITIES_PATH=backend/data
LOCAL_FACILITIES_STALE_DAYS=7

# Server-only: create a NEW key; never reuse a key exposed in browser code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Community facilities are stored separately from the immutable OSM snapshots.
# Default database: backend/data/community.sqlite3 (automatically created, gitignored).
# COMMUNITY_DB_PATH=/absolute/path/to/community.sqlite3
COMMUNITY_REPORT_THRESHOLD=3
# Address submissions use Geocoding v6 permanent=true with MAPBOX_TOKEN.
# The Mapbox account needs permanent geocoding access (credit card/enterprise contract).
